.qbar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.meta { font-size: 24rpx; color: #8ea0b8; white-space: nowrap; }
.track { flex: 1; height: 10rpx; background: rgba(148,163,184,.15); border-radius: 99rpx; overflow: hidden; }
.fill { height: 100%; background: linear-gradient(90deg,#38bdf8,#6366f1); border-radius: 99rpx; transition: width .4s; }
.timer { font-size: 24rpx; color: #8ea0b8; }
.qtag { display: inline-block; font-size: 22rpx; background: rgba(99,102,241,.16); color: #a5b4fc;
  border-radius: 10rpx; padding: 4rpx 18rpx; margin-bottom: 16rpx; }
.qtext { font-size: 32rpx; line-height: 1.7; margin-bottom: 26rpx; font-weight: 500; }
.opts { display: flex; flex-direction: column; gap: 16rpx; }
.opt { display: flex; align-items: center; gap: 16rpx; background: rgba(13,20,35,.85); border: 1rpx solid rgba(148,163,184,.14);
  border-radius: 18rpx; padding: 22rpx 24rpx; font-size: 28rpx; }
.opt .k { width: 48rpx; height: 48rpx; flex: none; border-radius: 12rpx; background: rgba(148,163,184,.13);
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #8ea0b8; }
.opt.correct { border-color: #34d399; background: rgba(52,211,153,.10); }
.opt.correct .k { background: #34d399; color: #062; }
.opt.wrong { border-color: #f87171; background: rgba(248,113,113,.10); }
.opt.wrong .k { background: #f87171; color: #fff; }
.jbtn { display: flex; gap: 20rpx; }
.jbtn .j { flex: 1; padding: 26rpx; border-radius: 18rpx; font-size: 32rpx; background: rgba(13,20,35,.85);
  border: 1rpx solid rgba(148,163,184,.2); color: #e6edf7; }
.jbtn .j.off { opacity: .5; }
textarea { width: 100%; min-height: 180rpx; background: rgba(13,20,35,.85); border: 1rpx solid rgba(148,163,184,.2);
  border-radius: 18rpx; color: #e6edf7; padding: 20rpx; font-size: 28rpx; box-sizing: border-box; }
.grade { display: flex; gap: 16rpx; justify-content: center; margin-top: 20rpx; }
.grade .g { width: 76rpx; height: 76rpx; border-radius: 50%; border: 1rpx solid rgba(148,163,184,.2);
  background: rgba(13,20,35,.85); color: #e6edf7; font-size: 28rpx; display: flex; align-items: center; justify-content: center; }
.grade .g.sel { background: #6366f1; border-color: #6366f1; color: #fff; }
.grade-tip { text-align: center; color: #8ea0b8; font-size: 22rpx; margin-top: 12rpx; }
.feedback { margin-top: 22rpx; padding: 20rpx 24rpx; border-radius: 18rpx; font-size: 26rpx; line-height: 1.7; white-space: pre-wrap; }
.feedback.ok { background: rgba(52,211,153,.09); border: 1rpx solid rgba(52,211,153,.35); }
.feedback.no { background: rgba(248,113,113,.09); border: 1rpx solid rgba(248,113,113,.35); }
.next { margin-top: 24rpx; }
.quit { margin-top: 10rpx; }
