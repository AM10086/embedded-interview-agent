/* app.wxss 全局样式 */
page {
  background: #070b14;
  color: #e6edf7;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
.container { padding: 30rpx; }
.card {
  background: rgba(17, 25, 40, 0.72);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.btn {
  border-radius: 18rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
  border: none;
  line-height: 1.4;
}
.btn-primary {
  background: linear-gradient(135deg, #38bdf8, #6366f1);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(56, 189, 248, 0.3);
}
.btn-ghost {
  background: rgba(148, 163, 184, 0.12);
  color: #e6edf7;
  border: 1rpx solid rgba(148, 163, 184, 0.2);
}
.btn-row { display: flex; gap: 20rpx; margin-top: 24rpx; }
.btn-row .btn { flex: 1; }
.chip {
  display: inline-block;
  background: rgba(17, 25, 40, 0.72);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  color: #8ea0b8;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  margin: 0 12rpx 12rpx 0;
}
.chip.active {
  background: linear-gradient(135deg, #38bdf8, #6366f1);
  color: #fff;
  border-color: transparent;
}
.hidden { display: none; }
