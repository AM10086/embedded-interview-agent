.search { width: 100%; background: rgba(13,20,35,.85); border: 1rpx solid rgba(148,163,184,.2); border-radius: 18rpx;
  color: #e6edf7; padding: 20rpx 24rpx; font-size: 26rpx; box-sizing: border-box; margin-bottom: 20rpx; }
.chips { margin-bottom: 20rpx; }
.grp { margin-bottom: 24rpx; }
.grp-title { font-size: 28rpx; color: #a5b4fc; font-weight: 700; margin-bottom: 14rpx; }
.grp-title .cnt { font-size: 22rpx; color: #8ea0b8; font-weight: 400; margin-left: 12rpx; }
.bitem { background: rgba(13,20,35,.85); border: 1rpx solid rgba(148,163,184,.14); border-radius: 16rpx;
  padding: 20rpx 24rpx; margin-bottom: 14rpx; font-size: 26rpx; }
.bitem.open { border-color: #38bdf8; }
.bq { color: #e6edf7; }
.detail { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx dashed rgba(148,163,184,.2); color: #8ea0b8;
  font-size: 24rpx; line-height: 1.7; }
.bopt .oline { display: block; margin-bottom: 4rpx; }
.bans { color: #34d399; font-weight: 600; margin-top: 8rpx; }
.bexp { color: #e6edf7; margin-top: 8rpx; }
.empty { text-align: center; color: #8ea0b8; padding: 60rpx 0; }
